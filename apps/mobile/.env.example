# Copier en .env.local (jamais versionné). Aucune donnée secrète ici : tout ce qui commence
# par EXPO_PUBLIC_ est lisible dans l'application compilée.
EXPO_PUBLIC_API_URL=https://recette.epiceriefineminiardise.fr
# Code d'accès de l'app à la recette (= MO_TEST_CODE_APP du wp-config de la recette). Ignoré en production.
EXPO_PUBLIC_RECETTE_ACCESS=
